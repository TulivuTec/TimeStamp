PORT=5001
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret

# Clerk authentication
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Optional local/dev bootstrap
ENABLE_DEV_BOOTSTRAP=false
ADMIN_EMAILS=admin@example.com
SUPERADMIN_ACCESS_KEY=replace_with_a_long_random_value

# Optional mail delivery (used for tenant OTP emails and billing confirmation emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=replace_with_mail_password
MAIL_FROM=TimeStamp <mailer@example.com>

# Operations task reminders (generate keys with:
# node -e "console.log(require('web-push').generateVAPIDKeys())")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Facility signup notifications
# Comma-separated list. Defaults can be pkaranjaxn@gmail.com and hubtulivu@gmail.com if not set.
FACILITY_SIGNUP_NOTIFICATION_EMAILS=pkaranjaxn@gmail.com,hubtulivu@gmail.com

# Frontend origin used for Stripe redirects and Clerk verification
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Stripe billing
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Standard plan: $35/month recurring price ID from Stripe Dashboard
STRIPE_PRICE_STANDARD_10=price_11
# Pro plan: $55/month recurring price ID from Stripe Dashboard
STRIPE_PRICE_PRO_25=price_15

# Optional explicit Stripe return URLs
STRIPE_SUCCESS_URL=http://localhost:3000/admin/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/admin/billing?checkout=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/admin/billing

# Optional billing policy
STRIPE_BILLING_GRACE_MODE=allow_past_due

# Payroll provider integration
# disabled = submission endpoint returns config error
# mock = non-provider sandbox mode for local verification
# live = submit to the URL below with bearer auth
PAYROLL_PROVIDER_MODE=disabled
GUSTO_API_BASE_URL=https://api.gusto-demo.com
GUSTO_COMPANY_ACCESS_TOKEN=your_gusto_company_access_token
GUSTO_COMPANY_ID=your_gusto_company_id
GUSTO_WEBHOOK_VERIFICATION_TOKEN=replace_with_the_verified_gusto_webhook_token
GUSTO_PROCESSING_TIMEOUT_MS=45000
GUSTO_PROCESSING_POLL_INTERVAL_MS=1500

# Required for GET /api/auth/gusto/callback (manual one-time OAuth code exchange)
# and for automatic access-token refresh in backend/config/gustoProvider.js
GUSTO_CLIENT_ID=your_gusto_app_client_id
GUSTO_CLIENT_SECRET=your_gusto_app_client_secret
GUSTO_OAUTH_REDIRECT_URI=http://localhost:5001/api/auth/gusto/callback

# GUSTO_COMPANY_ACCESS_TOKEN and GUSTO_REFRESH_TOKEN above are only used to
# bootstrap the first row in the `gustotokens` MongoDB collection. After that,
# the stored/rotated tokens in MongoDB are the source of truth, not these
# env vars — see project-guide/payroll-runbook.md, Incident 6.
GUSTO_REFRESH_TOKEN=your_gusto_refresh_token